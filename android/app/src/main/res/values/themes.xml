<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light when the phone is in light mode; values-night switches to the dark parent. The WebView's
         prefers-color-scheme follows this, so the web app's "기기 설정" mode matches the phone. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
